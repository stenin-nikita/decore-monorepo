{
  "name": "@decore/vesta",
  "version": "0.1.1",
  "description": "Vite plugin for building server and SSR applications.",
  "keywords": [
    "vite",
    "vite-plugin",
    "server",
    "ssr"
  ],
  "author": "Nikita Stenin <stenin.nikita@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stenin-nikita/decore-monorepo.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./lib/index.mjs",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      },
      "default": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./lib/vite.d.mts",
        "default": "./lib/vite.mjs"
      },
      "require": {
        "types": "./lib/vite.d.cts",
        "default": "./lib/vite.cjs"
      },
      "default": {
        "types": "./lib/vite.d.mts",
        "default": "./lib/vite.mjs"
      }
    }
  },
  "scripts": {
    "prepare": "pnpm build",
    "build": "tsdown",
    "fmt": "prettier -w .",
    "lint:code": "eslint .",
    "lint:fmt": "prettier -c .",
    "lint:ts": "tsc --noEmit"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@rolldown/pluginutils": "catalog:",
    "srvx": "catalog:"
  },
  "devDependencies": {
    "@decore/eslint-config": "workspace:",
    "@decore/prettier-config": "workspace:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
